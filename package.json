{
  "name": "serverlesswp",
  "version": "0.7.0",
  "description": "Run PHP on Lambda (AWS, Netlify, Vercel)",
  "keywords": [
    "serverless",
    "wordpress",
    "php",
    "netlify",
    "vercel"
  ],
  "homepage": "https://github.com/mitchmac/serverlesswp-node#readme",
  "main": "src/index.js",
  "author": "Mitch MacKenzie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchmac/serverlesswp-node.git"
  },
  "files": [
    "src/",
    "php-files/",
    "wordpress.js",
    "wordpress-assets/"
  ],
  "dependencies": {
    "isbinaryfile": "^5.0.0",
    "wait-on": "^9.0.5",
    "@aws-sdk/client-s3": "^3.772.0",
    "@vercel/blob": "^2.3.3",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "jest": "^29.5.0"
  },
  "scripts": {
    "test": "jest --testPathIgnorePatterns \"e2e|tests/wordpress|packages/\"",
    "local-tests": "npm run test && cd tests/e2e && ./local.sh",
    "test:wordpress": "node --test --test-concurrency=1 tests/wordpress/*.test.js"
  }
}
